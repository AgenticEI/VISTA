    {
      "id": "artifact.public.write@1",
      "description": "Save a package-generated image, mask, numeric array, JSON or text into this episode's current observation record.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "mask",
              "array",
              "json",
              "text"
            ]
          },
          "data": {}
        },
        "required": [
          "name",
          "kind",
          "data"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "step": {
            "type": "integer"
          }
        }
      }

    {
      "id": "observation.libero.rgbd@1",
      "description": "Capture aligned top-left RGB, metric depth, world XYZ and camera calibration from a live camera.",
      "input_schema": {
        "type": "object",
        "properties": {
          "camera": {
            "type": "string",
            "enum": [
              "agentview",
              "wrist"
            ],
            "default": "agentview"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "capture_id": {
            "type": "string"
          },
          "camera": {
            "type": "string"
          },
          "step": {
            "type": "integer"
          },
          "env_steps": {
            "type": "integer"
          },
          "depth_unit": {
            "const": "meter"
          },
          "image_origin": {
            "const": "top-left"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "calibration": {
            "type": "object",
            "description": "intrinsic_K and extrinsic_cam2world in the aligned image frame."
          },
          "artifacts": {
            "type": "object",
            "description": "RGB, metric depth, world XYZ and calibration references."
          },
          "_rgb_array": {
            "x-python-type": "numpy.ndarray",
            "description": "HxWx3 uint8 RGB."
          },
          "_depth_m_array": {
            "x-python-type": "numpy.ndarray",
            "description": "HxW float32 metric depth."
          },
          "_world_xyz_array": {
            "x-python-type": "numpy.ndarray",
            "description": "HxWx3 sensor-derived world coordinates, metres."
          }
        }
      }
    },
    {
      "id": "geometry.libero.back_project@1",
      "description": "Localize pixels or a region using the sensor-derived world map of a recorded observation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "row": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Pixel row (0=top) in the selected resolution image."
          },
          "col": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Pixel column (0=left) in the selected resolution image."
          },
          "step": {
            "type": "integer",
            "default": -1,
            "description": "Depth/world-map step; 0 = initial, -1 = latest."
          },
          "camera": {
            "type": "string",
            "enum": [
              "agentview",
              "wrist"
            ],
            "description": "Camera to back-project from (default agentview)."
          },
          "resolution": {
            "type": "string",
            "enum": [
              "high",
              "low"
            ],
            "description": "Coordinate system for row/col (default high). Use low only when row/col came from the embedded/standard 256 image."
          },
          "row_range": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            },
            "description": "Region mode: [r0, r1] pixel row window. Requires col_range."
          },
          "col_range": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            },
            "description": "Region mode: [c0, c1] pixel col window. Requires row_range."
          },
          "z_min": {
            "type": [
              "number",
              "null"
            ],
            "description": "Region mode: keep only pixels with world z >= z_min."
          },
          "z_max": {
            "type": [
              "number",
              "null"
            ],
            "description": "Region mode: keep only pixels with world z <= z_max."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "description": "Unmodified native sensor-localization result, including source camera/step and world_xyz when found."
      }
    },
    {
      "id": "perception.sam3.segment@1",
      "description": "Segment a recorded camera view with SAM3 and locate its mask in the sensor-derived world map.",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Object/text prompt to segment."
          },
          "camera": {
            "type": "string",
            "enum": [
              "agentview",
              "wrist"
            ],
            "description": "Artifact camera to use (default agentview)."
          },
          "step": {
            "type": "integer",
            "default": -1,
            "description": "Step to segment; -1 = latest."
          },
          "point": {
            "type": [
              "array",
              "null"
            ],
            "description": "Optional single positive point as [row, col]. Mutually exclusive with prompt.",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "min_score": {
            "type": "number",
            "description": "Minimum accepted mask score (default 0.2)."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "description": "Unmodified native sensor-localization result, including source camera/step and world_xyz when found."
      }
    },
    {
